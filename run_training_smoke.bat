@echo off
setlocal
cd /d "%~dp0"
if not exist venv\Scripts\python.exe (echo Run setup.bat first. & pause & exit /b 1)
set PY=venv\Scripts\python.exe

echo ============================================================
echo  SignBridge — Isolated-sign SMOKE TEST pipeline
echo  Dataset: vidit031/isl-isolated-8words (8 glosses, 56 clips)
echo  Purpose: Quick end-to-end validation, NOT a final benchmark.
echo ============================================================
echo.

echo [1/7] Checking environment...
%PY% -m scripts.check_env
if errorlevel 1 (
  echo [WARN] Some dependency issues detected above. Proceeding anyway.
)

echo.
echo [2/7] Downloading isolated-smoke dataset (~25 MB)...
%PY% -m scripts.download_dataset --dataset isolated-smoke
if errorlevel 1 goto :error

echo.
echo [3/7] Copying smoke dataset metadata to data\raw so pipeline scripts find it...
if not exist data\raw mkdir data\raw
copy /Y data\raw\isolated_smoke\metadata.csv data\raw\metadata.csv >nul 2>&1
xcopy /E /I /Y data\raw\isolated_smoke\* data\raw\ >nul 2>&1

echo.
echo [4/7] Extracting MediaPipe landmarks from smoke-test clips...
%PY% -m preprocessing.build_dataset
if errorlevel 1 goto :error

echo.
echo [5/7] Training Random Forest baseline (smoke test only)...
%PY% -m training.train_baseline
if errorlevel 1 goto :error

echo.
echo [6/7] Evaluating and writing metrics...
%PY% -m training.evaluate
if errorlevel 1 (echo [WARN] Evaluate step failed — continuing to report)

echo.
echo [7/7] Writing reports...
%PY% -m training.model_report
if errorlevel 1 (echo [WARN] Report step failed — check reports\)

echo.
echo ============================================================
echo  Smoke test pipeline completed.
echo  IMPORTANT: 8-word/56-clip results are NOT research metrics.
echo  They only verify the pipeline runs end-to-end. 
echo  Run run_training_full_isolated.bat for the 40-word baseline.
echo  Review: reports\evaluation.md and models\baseline\
echo ============================================================
pause
exit /b 0

:error
echo.
echo Pipeline step failed. Read the error above.
echo No accuracy numbers are generated by this script.
pause
exit /b 1
